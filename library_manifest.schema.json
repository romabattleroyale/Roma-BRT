{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RomaCityLibrary Manifest",
  "type": "object",
  "required": ["library_id", "name", "version", "type", "engine", "target", "destination", "approved"],
  "properties": {
    "library_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "type": {"enum": ["houses", "palazzi", "architecture", "roads", "poi", "interiors", "props", "vegetation", "infrastructure"]},
    "engine": {"const": "Godot 4.7.2"},
    "target": {"const": "Android"},
    "destination": {"type": "string", "pattern": "^city_library/"},
    "approved": {"type": "boolean"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "modules": {"type": "array", "items": {"type": "string"}},
    "road_generator": {"type": "boolean"},
    "terrain3d_authoritative": {"type": "boolean"}
  },
  "additionalProperties": true
}
