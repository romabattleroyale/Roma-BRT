extends Node
## Paints Terrain3D from poi_layout_resolved.json generated by poi_manager.gd.
## Terrain3D stores two texture IDs and one blend value per control-map pixel,
## so the two strongest zone weights are encoded as base/overlay + blend.

const RESOLVED_PATH := "res://city_library/poi/poi_layout_resolved.json"
const USER_RESOLVED_PATH := "user://poi_layout_resolved.json"
const ASSETS_PATH := "res://terrain_materials/terrain_assets_polyhaven_zones.tres"
const CACHE_DIR := "res://baked_city/terrain_paint"
const CACHE_SIGNATURE := CACHE_DIR + "/layout_signature.txt"
const TERRAIN_DATA_DIR := "res://terrain_data"
const DEFAULT_TEXTURE_ID := 2
const BLEND_RESOLUTION := 4
const MAP_SIZE_M := 2000

var _painting := false

func _ready() -> void:
    call_deferred("_run_when_ready")

func _run_when_ready() -> void:
    # TerrainBootstrap and its Terrain3D data are initialized asynchronously.
    for attempt in range(120):
        await get_tree().process_frame
        var root := get_tree().current_scene
        if root:
            var bootstrap := root.get_node_or_null("TerrainBootstrap")
            if bootstrap and bootstrap.get("terrain") != null:
                var terrain = bootstrap.get("terrain")
                if terrain and terrain.data != null:
                    await _paint_or_load_cache(terrain)
                    return
    push_warning("TERRAIN ZONES: Terrain3D non pronto dopo 120 frame; pittura saltata.")

func _paint_or_load_cache(terrain: Node) -> void:
    var pois := _load_resolved_pois()
    if pois.is_empty():
        push_warning("TERRAIN ZONES: layout POI non risolto; pittura saltata.")
        return

    if not ResourceLoader.exists(ASSETS_PATH):
        push_warning("TERRAIN ZONES: texture Poly Haven non ancora installate; pittura saltata senza alterare il terreno.")
        return

    var assets := load(ASSETS_PATH)
    if assets == null:
        push_warning("TERRAIN ZONES: impossibile caricare il set texture Poly Haven.")
        return

    # Apply the matching five-slot asset list even when the baked control map is cached.
    terrain.assets = assets
    var signature := JSON.stringify(pois)
    var old_signature := ""
    if FileAccess.file_exists(CACHE_SIGNATURE):
        old_signature = FileAccess.get_file_as_string(CACHE_SIGNATURE).strip_edges()
    if old_signature == signature:
        print("TERRAIN ZONES: cache presente e layout invariato; nessuna ripittura.")
        return

    _painting = true
    print("TERRAIN ZONES: inizio pittura basata su ", pois.size(), " POI risolti; step=", BLEND_RESOLUTION, "m")
    var visited := 0
    for x in range(0, MAP_SIZE_M + 1, BLEND_RESOLUTION):
        for z in range(0, MAP_SIZE_M + 1, BLEND_RESOLUTION):
            var pos := Vector3(float(x), 0.0, float(z))
            if not terrain.data.has_regionp(pos):
                continue
            var weights := _weights_at(Vector2(float(x), float(z)), pois)
            _apply_weights(terrain.data, pos, weights)
            visited += 1
        # Yield every row so mobile devices remain responsive during the one-time bake.
        await get_tree().process_frame
        if x % 200 == 0:
            print("TERRAIN ZONES: progress x=", x, "/", MAP_SIZE_M, " samples=", visited)

    terrain.data.update_maps()
    # Persist modified control maps into the normal startup cache and a dedicated
    # backup folder. Terrain3D saves region resources, not one monolithic .res file.
    terrain.data.save_directory(TERRAIN_DATA_DIR)
    terrain.data.save_directory(CACHE_DIR)
    _write_text(CACHE_SIGNATURE, signature + "\n")
    _write_text(CACHE_DIR + "/READY.txt", "Terrain3D zone paint saved from resolved POIs.\n")
    _painting = false
    print("TERRAIN ZONES: PASS painted samples=", visited, " saved to ", CACHE_DIR)

func _load_resolved_pois() -> Array:
    var path := RESOLVED_PATH if FileAccess.file_exists(RESOLVED_PATH) else USER_RESOLVED_PATH
    if not FileAccess.file_exists(path):
        return []
    var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
    if parsed is Array:
        return parsed
    return []

func _weights_at(pos: Vector2, pois: Array) -> Dictionary:
    var weights: Dictionary = {}
    for poi in pois:
        if not (poi is Dictionary):
            continue
        var center := Vector2(float(poi.get("x", 0.0)), float(poi.get("z", 0.0)))
        var radius := float(poi.get("radius", 220.0))
        var falloff := maxf(1.0, float(poi.get("falloff", 90.0)))
        var distance := pos.distance_to(center)
        var inner := maxf(0.0, radius - falloff)
        var outer := radius + falloff
        var weight := 1.0
        if distance >= outer:
            continue
        if distance > inner:
            var t := (distance - inner) / maxf(0.001, outer - inner)
            weight = 1.0 - smoothstep(0.0, 1.0, t)
        var texture_id := int(poi.get("texture_id", DEFAULT_TEXTURE_ID))
        weights[texture_id] = maxf(float(weights.get(texture_id, 0.0)), weight)

    if weights.is_empty():
        weights[DEFAULT_TEXTURE_ID] = 1.0
    return weights

func _apply_weights(data: Object, pos: Vector3, weights: Dictionary) -> void:
    var ids: Array = weights.keys()
    ids.sort_custom(func(a, b): return float(weights[a]) > float(weights[b]))
    var base_id := int(ids[0])
    var overlay_id := base_id
    var blend := 0.0
    if ids.size() > 1:
        overlay_id = int(ids[1])
        var base_weight := float(weights[base_id])
        var overlay_weight := float(weights[overlay_id])
        blend = overlay_weight / maxf(0.0001, base_weight + overlay_weight)
    data.set_control_auto(pos, false)
    data.set_control_base_id(pos, base_id)
    data.set_control_overlay_id(pos, overlay_id)
    data.set_control_blend(pos, blend)

func _write_text(path: String, value: String) -> void:
    var file := FileAccess.open(path, FileAccess.WRITE)
    if file:
        file.store_string(value)
        file.close()
    else:
        push_warning("TERRAIN ZONES: impossibile scrivere " + path)
