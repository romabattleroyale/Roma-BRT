extends RefCounted
class_name V37BuildingPositionsBlob

const DATA_B64 := ""

static func get_buildings() -> Array:
    var raw := Marshalls.base64_to_raw(DATA_B64)
    raw = raw.decompress(raw.size() * 20, FileAccess.COMPRESSION_GZIP)
    var parsed = JSON.parse_string(raw.get_string_from_utf8())
    return parsed if parsed is Array else []
